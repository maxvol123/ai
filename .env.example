DATABASE_URL="postgresql://postgres:postgres@localhost:15432/ai_news"
OPENAI_API="your_openai_api_key"
SCREENING_MODEL='gpt-5.6-luna'
RANKING_MODEL='gpt-5.6-terra'
CHAT_ID="your_telegram_chat_id"
HTTPAPI_TG="your_telegram_bot_token"
TELEGRAM_CHANNEL_ID="@your_channel"
# Optional: square background without baked-in text or logo, scaled to 1200x1200.
# DONTSKIP_TEMPLATE_PATH="assets/dontskip-background.png"
# Optional: defaults to assets/tikrd-logo.png; otherwise uses a TIKRD wordmark.
# DONTSKIP_LOGO_PATH="assets/tikrd-logo.png"
MAX_ARTICLE_AGE_HOURS=24
